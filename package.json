{
  "name": "moootion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,green \"tsx server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "web": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "dev:watch": "concurrently -k -n api,web -c gray,green \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "start": "node tools/start.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@fontsource-variable/tiktok-sans": "^5.3.0",
    "@fontsource/babylonica": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@tabler/icons-react": "^3.49.0",
    "hono": "^4.13.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.535",
    "zod": "4.5.4",
    "zustand": "^5.0.15"
  }
}
